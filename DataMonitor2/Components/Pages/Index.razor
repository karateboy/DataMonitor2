@page "/"
@using DataMonitor2.Db
@using DataMonitor2.Models
@using Syncfusion.Blazor.Buttons
@inject SysConfigIo SysConfigIo
@inject MonitorTypeIo MonitorTypeIo
@inject AlarmIo AlarmIo
@rendermode InteractiveServer

<PageTitle>Index</PageTitle>

<h3>警報確認</h3>
<br/>
<ol>
    @foreach (var monitor in MonitorAlarmRules.Monitors)
    {
        var monitorAlarmRule = MonitorAlarmRules.MonitorAlarmRuleMap[monitor];
        @foreach (var mtRule in monitorAlarmRule.Rules.Where(mtRule => mtRule.NotificationNeeded()))
        {
            <li>@monitor:@MonitorTypeIo.MapReadOnly[mtRule.Item].Desp 上下限警報
                <SfButton CssClass="e-primary" @onclick="()=>HandleRuleAck(monitorAlarmRule, mtRule)"
                          Content="確認"></SfButton>
            </li>
        }
    }
</ol>
@code {


    void HandleRuleAck(AlarmRule rule, MonitorTypeRule mtRule)
    {
        var mt = MonitorTypeIo.MapReadOnly[mtRule.Item];
        _ = AlarmIo.AddAlarm(AlarmIo.AlarmLevel.Info, $"使用者確認了{mt.Desp}警報 ");
        mtRule.AckNotification();
        MonitorAlarmRules.UpdateAlarmRule(rule, SysConfigIo);
    }


}