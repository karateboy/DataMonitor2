@using System.Security.Claims
@using DataMonitor2.Db
@using Syncfusion.Blazor.Grids
@using Action = Syncfusion.Blazor.Grids.Action
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Models
@inject ILogger<AlarmRuleConfig> Logger
@inject SysConfigIo SysConfigIo
@inject MonitorTypeIo MonitorTypeIo
@rendermode InteractiveServer


<h3>監測測站: @Monitor</h3>
<div class="m-1 p-1">
    <ul>
        @if (_canEdit)
        {
            <li>
                <SfCheckBox @bind-Checked="@_alarmRule!.CheckCommunication"
                            ValueChange="ValueChange"
                            TChecked="bool">通訊異常警報
                </SfCheckBox>
                <span>&nbsp;</span>
            </li>
            
            <li>
                <SfCheckBox @bind-Checked="@_alarmRule!.CheckMonitorTypeRules"
                            ValueChange="ValueChange"
                            TChecked="bool">數值異常警報
                </SfCheckBox>
            </li>
        }
        <li>
            <SfCheckBox Checked="true" readonly="">上傳環保局警報</SfCheckBox>
        </li>
    </ul>

</div>

<SfGrid @ref="Grid" DataSource="@_alarmRule?.Rules" Toolbar="@(new List<string> { "Edit", "Update", "Cancel" })"
        ShowColumnMenu="true"
        AllowPaging="false" AllowSorting="true" AllowResizing="true">
    <GridEditSettings Mode="EditMode.Normal" AllowAdding="false" AllowDeleting="false"
                      AllowEditing="_canEdit"></GridEditSettings>
    <GridColumns>
        <GridColumn Field="@nameof(MonitorTypeRule.Item)"
                    HeaderText="測項"
                    TextAlign="TextAlign.Left"
                    IsPrimaryKey="true"
                    IsIdentity="true"
                    AllowEditing="false"
                    Width="15"
                    Visible="true">
            <Template>
                @if (context is MonitorTypeRule rule)
                {
                    var mtItem = MonitorTypeIo.MapReadOnly[rule.Item];
                    <strong>@mtItem.Desp.Trim()</strong>
                }
            </Template>
            <EditTemplate>
                @if (context is MonitorTypeRule rule)
                {
                    var mtItem = MonitorTypeIo.MapReadOnly[rule.Item];
                    <strong>@mtItem.Desp.Trim()</strong>
                }
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(MonitorTypeRule.AlarmLow)"
                    HeaderText="異常下限"
                    TextAlign="TextAlign.Left"
                    Width="15"
                    AllowEditing="true"
                    Visible="true"></GridColumn>
        <GridColumn Field="@nameof(MonitorTypeRule.AlarmHigh)"
                    HeaderText="異常上限"
                    TextAlign="TextAlign.Left"
                    AllowEditing="true"
                    Width="15"
                    Visible="true"></GridColumn>
        <GridColumn Field="@nameof(MonitorTypeRule.ConstantCount)"
                    HeaderText="定值筆數"
                    TextAlign="TextAlign.Left"
                    AllowEditing="true"
                    Width="15"
                    Visible="true"></GridColumn>
        <GridColumn Field="@nameof(MonitorTypeRule.EfficiencyLowAlarm)"
                    HeaderText="有效率低限(%)"
                    TextAlign="TextAlign.Left"
                    AllowEditing="true"
                    Width="15"
                    Visible="true"></GridColumn>
    </GridColumns>
    <GridEvents OnActionComplete="OnActionComplete" TValue="MonitorTypeRule"></GridEvents>
</SfGrid>


@code {

    [Parameter] public string Monitor { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private SfGrid<MonitorTypeRule> Grid;
    private AlarmRule? _alarmRule;

    bool _canEdit;

    protected override async Task OnParametersSetAsync()
    {
        _alarmRule = MonitorAlarmRules.MonitorAlarmRuleMap[Monitor];
        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            var user = authState.User;
            if (user.IsInRole(Role.Admin))
            {
                _canEdit = true;
            }
        }
    }

    private void ValueChange(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        MonitorAlarmRules.UpdateAlarmRule(_alarmRule!, SysConfigIo);
    }

    private void OnActionComplete(ActionEventArgs<MonitorTypeRule> args)
    {
        try
        {
            if (args.RequestType != Action.Save)
                return;

            var updatedRule = _alarmRule!.Rules.Find(rule => rule.Item == args.Data?.Item);
            if (updatedRule is null || args.Data is null) return;
            var index = _alarmRule!.Rules.IndexOf(updatedRule);
            _alarmRule?.Rules[index] = args.Data;
            MonitorAlarmRules.UpdateAlarmRule(_alarmRule!, SysConfigIo);
        }
        catch (Exception e)
        {
            Logger.LogError(e.ToString());
        }
    }

}