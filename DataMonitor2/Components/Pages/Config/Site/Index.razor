@page "/Config/Site"
@using Syncfusion.Blazor.Navigations
@rendermode InteractiveServer

<SfTab>
    <TabAnimationSettings>
        <TabAnimationPrevious Effect=AnimationEffect.FadeZoomIn></TabAnimationPrevious>
        <TabAnimationNext Effect=AnimationEffect.FadeZoomIn></TabAnimationNext>
    </TabAnimationSettings>
    <TabItems>
        <TabItem>
            <ChildContent>
                <TabHeader Text="LINE 通訊參數" IconCss="e-icons e-location"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="m-3">
                    <NotifyTab></NotifyTab>
                </div>
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent>
                <TabHeader Text="其他參數" IconCss="e-icons e-location"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="m-3">
                    <SysConfigTab></SysConfigTab>
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

