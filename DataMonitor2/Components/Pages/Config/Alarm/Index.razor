@page "/Config/Alarm"
@using DataMonitor2.Models
@using Syncfusion.Blazor.Navigations
@rendermode InteractiveServer

<SfTab>
    <TabAnimationSettings>
        <TabAnimationPrevious Effect=AnimationEffect.FadeZoomIn></TabAnimationPrevious>
        <TabAnimationNext Effect=AnimationEffect.FadeZoomIn></TabAnimationNext>
    </TabAnimationSettings>
    <TabItems>
        @{
            foreach (var monitor in MonitorAlarmRules.Monitors)
            {
                <TabItem>
                    <ChildContent>
                        <TabHeader Text="@monitor" IconCss="e-icons e-location"></TabHeader>
                    </ChildContent>
                    <ContentTemplate>
                        <div class="m-3">
                            <AlarmRuleConfig Monitor="@monitor"></AlarmRuleConfig>
                        </div>
                    </ContentTemplate>
                </TabItem>       
            }
        }
    </TabItems>
</SfTab>

